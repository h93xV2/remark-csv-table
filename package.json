{
    "name": "remark-csv-table",
    "description": "A Remark plugin that converts local CSV files referenced by Markdown directives into GFM tables.",
    "license": "MIT",
    "repository": {
        "url": "https://github.com/h93xV2/remark-csv-table",
        "type": "git"
    },
    "homepage": "https://github.com/h93xV2/remark-csv-table#readme",
    "bugs": {
        "url": "https://github.com/h93xV2/remark-csv-table/issues"
    },
    "keywords": [
        "remark",
        "remark-plugin",
        "unified",
        "markdown",
        "csv",
        "table",
        "gfm"
    ],
    "author": "h93xV2",
    "type": "module",
    "version": "0.1.5",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "bun.lock"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]"
                }
            ],
            "@semantic-release/github"
        ]
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "prepare": "husky",
        "test": "bun run test:unit && bun run test:integration",
        "test:integration": "bun test test/integration",
        "test:package": "bun run build && bun test test/package",
        "test:unit": "bun test test/unit",
        "typecheck": "tsc --noEmit",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "check": "biome check ."
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,tsx,json,jsonc}": "biome check --write"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.11",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@semantic-release/commit-analyzer": "13.0.1",
        "@semantic-release/git": "11.0.1",
        "@semantic-release/github": "12.0.9",
        "@semantic-release/npm": "13.1.5",
        "@semantic-release/release-notes-generator": "14.1.1",
        "@types/bun": "1.4.0",
        "husky": "9.1.7",
        "lint-staged": "17.4.1",
        "mdast-util-directive": "3.1.0",
        "remark-directive": "4.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-stringify": "11.0.0",
        "semantic-release": "25.0.9",
        "to-vfile": "8.0.0",
        "typescript": "^7",
        "vfile": "6.0.3"
    },
    "peerDependencies": {
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.0"
    },
    "dependencies": {
        "@types/mdast": "4.0.4",
        "csv-parse": "7.0.2",
        "remark": "15.0.1",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    }
}
